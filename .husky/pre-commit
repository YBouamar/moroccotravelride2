# Local quality gate (ADR-015): secret scan on staged changes, then lint and format staged files.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found: install it (winget install Gitleaks.Gitleaks) and restart the terminal." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner || exit 1
pnpm exec lint-staged
