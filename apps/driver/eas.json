{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://staging-db.example.invalid",
        "EXPO_PUBLIC_API_URL": "https://staging.example.invalid"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://db.example.invalid",
        "EXPO_PUBLIC_API_URL": "https://www.example.invalid"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
