# MoroccoTravelRide : environment variables
# Copy to apps/web/.env.local (and apps/driver/.env.local) and fill in. Never commit real values.
# NEXT_PUBLIC_* and EXPO_PUBLIC_* are exposed to the browser / app: never put a secret in them.

# --- Supabase (local values are printed by `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to client or mobile.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret used to sign guest "manage my booking" magic links (32+ random bytes)
BOOKING_LINK_SECRET=

# --- Payments ---
# Launch: offline only (bank transfer to carrier, cash to driver). Online card provider postponed.
# mock | cmi
PAYMENT_PROVIDER=mock
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="MoroccoTravelRide <no-reply@example.com>"

# --- Anti-bot (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Driver app (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
