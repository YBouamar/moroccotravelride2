# MoroccoTravelRide : environment variables
# Web: copy to apps/web/.env.local. Driver app: copy the EXPO_PUBLIC_* lines to apps/driver/.env.local.
# NEXT_PUBLIC_* and EXPO_PUBLIC_* are public (bundled into the browser / app): never put a secret in them.
# Local values: `pnpm exec supabase status`.

# --- Supabase (web) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (service role). Never expose to the browser or the mobile app.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Salt for hashing rate-limit subjects (IP, e-mail): 32+ random bytes, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=
# Signs guest booking links (32+ random bytes). Optional: derived from RATE_LIMIT_SALT when empty.
BOOKING_LINK_SECRET=
# Shared secret of the scheduled call POST /api/cron/emails (32+ random bytes). Empty = disabled.
CRON_SECRET=

# --- Anti-bot (Cloudflare Turnstile). Local test keys always pass; production needs real keys. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Payments (online card postponed, ADR-016) ---
PAYMENT_PROVIDER=mock

# --- E-mail (Resend, Phase 3) ---
RESEND_API_KEY=
EMAIL_FROM="MoroccoTravelRide <no-reply@example.com>"

# --- Monitoring (Sentry, Phase 7) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Driver app (Expo). Emulator: http://10.0.2.2:55321, phone: your PC LAN IP. ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
